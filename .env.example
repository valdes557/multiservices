# === Base de données (OBLIGATOIRE) ===
# MongoDB Atlas: mongodb+srv://user:password@cluster.mongodb.net/multiservices
MONGODB_URI=

# === Authentification (OBLIGATOIRE) ===
# Chaîne aléatoire longue. Générez-en une: openssl rand -base64 32
JWT_SECRET=

# === URL publique du site (OBLIGATOIRE en production) ===
# Vercel:  https://votre-projet.vercel.app
# Render:  https://multiservices.onrender.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === IA (OPTIONNEL) ===
# Active la correction/reformulation de texte par IA. Sans clé, un moteur local est utilisé.
OPENAI_API_KEY=


# === Outils Lot 7B (optionnel — chaque outil affiche un fallback "service non configuré" sans clé) ===
REMOVE_BG_API_KEY=          # Suppression d'arrière-plan (remove.bg)
DEEPL_API_KEY=              # Traduction de documents (DeepL, clé ...:fx = gratuit)
PLAGIARISM_API_KEY=         # Vérificateur de plagiat
PLAGIARISM_API_URL=         # Endpoint du service de plagiat
CLOUDCONVERT_API_KEY=       # PDF -> Word/Excel (CloudConvert)
