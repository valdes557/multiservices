# Base de données MongoDB (Atlas ou local)
MONGODB_URI=mongodb://localhost:27017/multiservices

# Secret JWT pour l'authentification
JWT_SECRET=change-me-en-production

# URL publique du site (utilisée pour le SEO: sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=https://multiservices.app

# (Optionnel) Clé OpenAI pour la correction/reformulation IA de l'Outil 3
# Si absente, l'outil utilise un moteur local déterministe
OPENAI_API_KEY=
